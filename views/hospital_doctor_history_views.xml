<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hospital_doctor_history_list" model="ir.ui.view">
        <field name="name">hospital.doctor.history.list</field>
        <field name="model">hospital.doctor.history</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_date"/>
                <field name="change_date"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_doctor_history_form" model="ir.ui.view">
        <field name="name">hospital.doctor.history.form</field>
        <field name="model">hospital.doctor.history</field>
        <field name="arch" type="xml">
            <form string="Doctor History">
                <sheet>
                    <group>
                        <group string="Subject Assignment">
                            <field name="patient_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="doctor_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group string="Period &amp; Status">
                            <field name="appointment_date"/>
                            <field name="change_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hospital_doctor_history" model="ir.actions.act_window">
        <field name="name">Doctor History</field>
        <field name="res_model">hospital.doctor.history</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
