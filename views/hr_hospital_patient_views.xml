<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_hospital_patient_list" model="ir.ui.view">
        <field name="name">hr.hospital.patient.list</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="birth_date"/>
                <field name="age"/>
                <field name="gender"/>
                <field name="blood_group"/>
                <field name="insurance_number"/>
                <field name="personal_doctor_id"/>
            </list>
        </field>
    </record>

    <record id="view_hr_hospital_patient_form" model="ir.ui.view">
        <field name="name">hr.hospital.patient.form</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Personal Data">
                            <field name="name"/>
                            <field name="insurance_number"/>
                            <field name="personal_doctor_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group string="Medical Information">
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="gender"/>
                            <field name="blood_group"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Doctor History" name="doctor_history">
                            <field name="doctor_history_ids" readonly="1">
                                <list>
                                    <field name="doctor_id" options="{'no_open': True}"/>
                                    <field name="appointment_date"/>
                                    <field name="change_date"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_hospital_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hr.hospital.patient</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
