<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_hospital_doctor_category_list" model="ir.ui.view">
            <field name="name">hr.hospital.category.list</field>
            <field name="model">hr.hospital.category</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="view_hospital_doctor_category_form" model="ir.ui.view">
            <field name="name">hr.hospital.category.form</field>
            <field name="model">hr.hospital.category</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <notebook>
                            <page string="Список лікарів" name="doctors">
                                <field name="doctor_ids" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hospital_doctor_category" model="ir.actions.act_window">
            <field name="name">Doctor Categories</field>
            <field name="res_model">hr.hospital.category</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
