<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_hospital_visit_list" model="ir.ui.view">
        <field name="name">hr.hospital.visit.list</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'planned'"
                  decoration-success="state == 'completed'"
                  decoration-muted="state == 'cancelled'">
                <field name="planned_date"/>
                <field name="actual_date"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="disease_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'planned'"
                       decoration-success="state == 'completed'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_hr_hospital_visit_form" model="ir.ui.view">
        <field name="name">hr.hospital.visit.form</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group string="Visit Details">
                            <field name="patient_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="doctor_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="disease_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group string="Schedule">
                            <field name="planned_date"/>
                            <field name="actual_date" invisible="state == 'planned'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Epicrisis / Summary" name="summary">
                            <field name="summary" widget="html" placeholder="Describe patient status and recommendations..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_hospital_visit" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">hr.hospital.visit</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
