<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_hospital_visit_report_wizard_form" model="ir.ui.view">
        <field name="name">hr.hospital.visit.report.wizard.form</field>
        <field name="model">hr.hospital.visit.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group string="Суб'єкти">
                        <field name="doctor_ids" widget="many2many_tags"/>
                        <field name="patient_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Параметри">
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="only_completed"/>
                        <field name="disease_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_get_report" string="Показати візити" type="object" class="btn-primary"/>
                    <button string="Скасувати" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_report_wizard_doctor" model="ir.actions.act_window">
        <field name="name">Звіт по візитах</field>
        <field name="res_model">hr.hospital.visit.report.wizard</field>
        <field name="binding_model_id" ref="model_hr_hospital_doctor"/>
        <field name="target">new</field>
        <field name="view_mode">form</field>
    </record>

    <record id="action_report_wizard_patient" model="ir.actions.act_window">
        <field name="name">Звіт по візитах</field>
        <field name="res_model">hr.hospital.visit.report.wizard</field>
        <field name="binding_model_id" ref="model_hr_hospital_patient"/>
        <field name="target">new</field>
        <field name="view_mode">form</field>
    </record>

</odoo>
