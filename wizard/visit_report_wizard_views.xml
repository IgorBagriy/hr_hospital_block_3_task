<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_visit_report_wizard_form" model="ir.ui.view">
        <field name="name">visit.report.wizard.form</field>
        <field name="model">visit.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Visit Report">
                <group>
                    <group string="Subjects">
                        <field name="doctor_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="patient_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <group string="Parameters">
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="only_completed"/>
                        <field name="disease_id" options="{'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_get_report" string="Generate Report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_report_wizard_doctor" model="ir.actions.act_window">
        <field name="name">Visit Report</field>
        <field name="res_model">visit.report.wizard</field>
        <field name="binding_model_id" ref="model_hr_hospital_doctor"/>
        <field name="target">new</field>
        <field name="view_mode">form</field>
        <field name="binding_view_types">list,form</field>
    </record>

    <record id="action_report_wizard_patient" model="ir.actions.act_window">
        <field name="name">Visit Report</field>
        <field name="res_model">visit.report.wizard</field>
        <field name="binding_model_id" ref="model_hr_hospital_patient"/>
        <field name="target">new</field>
        <field name="view_mode">form</field>
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>
